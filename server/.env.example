# Server Environment Variables
# Copy this file to .env and fill in the values

# Server Port
PORT=3000

# ============================================================================
# DATABASE (PostgreSQL)
# ============================================================================
# Выберите один из вариантов:

# Вариант 1: Локальный PostgreSQL на сервере (рекомендуется для VPS)
# DATABASE_URL="postgresql://miniapp_clientname:password@localhost:5432/miniapp_clientname"

# Вариант 2: Облачный PostgreSQL (бесплатно)
# Supabase: https://supabase.com (500MB бесплатно)
# Neon: https://neon.tech (512MB бесплатно)
# DATABASE_URL="postgresql://user:password@host.supabase.co:5432/postgres"

# Для локальной разработки (SQLite) - временно измените provider в schema.prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/miniapp_dev"

# Timezone (IANA format)
# Examples: Europe/Moscow, Asia/Yekaterinburg, Europe/Kaliningrad
TIMEZONE="Europe/Moscow"

# Telegram Bot
TELEGRAM_BOT_TOKEN="your_bot_token_from_botfather"

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:5173"

# Admin Telegram IDs (comma-separated)
# Get your ID from @userinfobot in Telegram
ADMIN_IDS="123456789"

# MiniApp URL (your deployed frontend URL for Telegram WebApp)
MINIAPP_URL="https://your-miniapp.yourdomain.com"

# Payment Configuration (YooKassa)
# Get from YooKassa dashboard
YOOKASSA_SHOP_ID="your_shop_id"
YOOKASSA_SECRET_KEY="your_secret_key"

# Telegram Payment Provider Token
# Get from BotFather: /mybots -> Bot Settings -> Payments
PAYMENT_PROVIDER_TOKEN="your_payment_provider_token"

# Security Settings
# Max pending (unpaid) bookings per user (0 = unlimited)
MAX_PENDING_BOOKINGS_PER_USER=3

# Auto-cancel unpaid bookings after N minutes (0 = disabled)
AUTO_CANCEL_UNPAID_MINUTES=30

# Rate limiting: requests per minute per IP
RATE_LIMIT_REQUESTS_PER_MINUTE=60
