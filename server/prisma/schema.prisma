generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String    @id @default(uuid())
  telegram_id          BigInt    @unique
  first_name           String?
  last_name            String?
  username             String?
  photo_url            String?
  birthday             DateTime?
  preferred_branch_id  String?
  is_admin             Boolean   @default(false)
  created_at           DateTime  @default(now())
  bookings             Booking[]
}

model Branch {
  id           String          @id @default(uuid())
  name         String
  address      String?
  phone        String?
  start_hour   Int             @default(10)
  end_hour     Int             @default(20)
  is_active    Boolean         @default(true)
  created_at   DateTime        @default(now())
  masters      MasterBranch[]
  services     BranchService[]
  bookings     Booking[]
  promotions   Promotion[]
}

model MasterBranch {
  id         String  @id @default(uuid())
  master     Master  @relation(fields: [master_id], references: [id], onDelete: Cascade)
  master_id  String
  branch     Branch  @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  branch_id  String

  @@unique([master_id, branch_id])
}

model BranchService {
  id         String  @id @default(uuid())
  branch     Branch  @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  branch_id  String
  service    Service @relation(fields: [service_id], references: [id], onDelete: Cascade)
  service_id String

  @@unique([branch_id, service_id])
}

model Master {
  id            String          @id @default(uuid())
  name          String
  telegram_id   BigInt?         @unique
  photo_url     String?
  role          String?
  bio           String?
  is_active     Boolean         @default(true)
  work_days     String?         @default("1,2,3,4,5")
  start_hour    Int             @default(10)
  end_hour      Int             @default(20)
  slot_interval Int             @default(30)
  created_at    DateTime        @default(now())
  services      MasterService[]
  bookings      Booking[]
  branches      MasterBranch[]
}

model Service {
  id               String          @id @default(uuid())
  name             String
  description      String?
  duration_minutes Int
  price            Int
  image_url        String?
  category         String?
  subcategory      String?         // Зависимая подкатегория (Женские/Мужские)
  hall             String?         // Глобальная подкатегория (Зал 1, Зал 2)
  is_active        Boolean         @default(true)
  created_at       DateTime        @default(now())
  masters          MasterService[]
  bookings         Booking[]
  branches         BranchService[]
}

model MasterService {
  id         String  @id @default(uuid())
  master     Master  @relation(fields: [master_id], references: [id], onDelete: Cascade)
  master_id  String
  service    Service @relation(fields: [service_id], references: [id], onDelete: Cascade)
  service_id String

  @@unique([master_id, service_id])
}

model Booking {
  id                String   @id @default(uuid())
  user              User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)
  user_id           String?
  master            Master?  @relation(fields: [master_id], references: [id], onDelete: SetNull)
  master_id         String?
  service           Service? @relation(fields: [service_id], references: [id], onDelete: SetNull)
  service_id        String?
  branch            Branch?  @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  branch_id         String?
  start_time        DateTime
  end_time          DateTime
  status            String   @default("pending") // pending, paid, cancelled, completed
  payment_id        String?
  client_phone      String?
  client_name       String?
  custom_price      Int?
  reminder_24h_sent Boolean  @default(false)
  reminder_1h_sent  Boolean  @default(false)
  created_at        DateTime @default(now())
}

model Promotion {
  id                   String       @id @default(uuid())
  name                 String
  description          String?
  discount_type        String       // 'percent' | 'fixed'
  discount_value       Int
  promo_code           String?      @unique
  start_date           DateTime?
  end_date             DateTime?
  is_active            Boolean      @default(true)
  applies_to_type      String       @default("all")  // 'all' | 'services' | 'categories'
  applies_to           String?      // comma-separated service IDs or category names
  max_uses_per_user    Int          @default(1)
  max_total_uses       Int?
  
  // Auto-apply (without promo code)
  is_auto_apply        Boolean      @default(false)
  valid_days           String?      // Days of week: "1,2,3,4,5" (1=Mon, 7=Sun)
  time_start           String?      // "10:00"
  time_end             String?      // "14:00"
  
  branch               Branch?      @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  branch_id            String?
  
  // Notification
  notify_clients       Boolean      @default(false)
  notification_message String?
  notification_sent    Boolean      @default(false)
  
  created_at           DateTime     @default(now())
  usages               PromoUsage[]
}

model PromoUsage {
  id           String    @id @default(uuid())
  promotion    Promotion @relation(fields: [promotion_id], references: [id], onDelete: Cascade)
  promotion_id String
  user_id      String
  used_at      DateTime  @default(now())

  // @@unique([promotion_id, user_id])  -- Removed to allow multiple usages per user
}

model Settings {
  id                          String  @id @default("main")
  birthday_enabled            Boolean @default(true)
  birthday_discount           Int     @default(10)      // % discount
  birthday_message            String  @default("🎂 С днём рождения! Дарим вам скидку {discount}%!")
  birthday_promo_days         Int     @default(7)       // Days the promo is valid
  birthday_notify_days_before Int     @default(0)       // Days before birthday to send notification (0 = on birthday)
  require_prepayment          Boolean @default(false)   // Require payment before booking is created
  banned_users                String  @default("[]")    // JSON array of banned telegram IDs
  
  // Message templates (use {name}, {date}, {time}, {service}, {master}, {price})
  welcome_message       String @default("👋 Добро пожаловать, {name}!\n\n🎉 Мы рады видеть вас в нашем сервисе бронирования!\n\n📱 Нажмите кнопку меню (слева от поля ввода) чтобы записаться.\n📋 Нажмите \"Мои записи\" чтобы посмотреть ваши бронирования.\n\n✨ Быстро, удобно, в любое время!")
  msg_booking_confirmed String @default("✅ Вы записаны!\n\n📅 Дата: {date}\n⏰ Время: {time}\n👤 Мастер: {master}\n⭐ Услуга: {service}\n\nЖдём вас!")
  msg_reminder_24h      String @default("🔔 Напоминание о записи!\n\nДо вашей встречи остался 1 день.\n\n📅 Дата: {date}\n⏰ Время: {time}\n👤 Мастер: {master}\n⭐ Услуга: {service}\n\nЖдём вас!")
  msg_reminder_2h       String @default("🔔 Вы записаны через 2 часа!\n\nЖдем вас совсем скоро!\n\n⏰ Время: {time}\n👤 Мастер: {master}\n⭐ Услуга: {service}\n\nДо встречи!")
  msg_payment_success   String @default("✅ Оплата прошла успешно!\n\nВаша запись подтверждена.\n📅 Дата: {date}\n⏰ Время: {time}\n👤 Мастер: {master}\n⭐ Услуга: {service}\n💰 Оплачено: {price} ₽")
}

